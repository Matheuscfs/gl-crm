# Vite expõe apenas variáveis com prefixo VITE_ ao front-end.
# A publishable key é pública/segura no cliente (o acesso é controlado por RLS).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Dados de demonstração (pacientes, agenda, leads e parcelas fictícios).
# Com o Supabase configurado eles ficam DESLIGADOS: a tela mostra só o que está no banco.
# Use 1 para revê-los (apresentação, testes de layout).
VITE_DEMO_DATA=0

# Google (Calendar + Drive) — OAuth Client ID (tipo "Web application") do Google Cloud.
# Habilite as APIs Google Calendar e Google Drive; adicione a origem do app em "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Calendário de destino dos agendamentos. Deixe em branco para usar o "primary".
VITE_GOOGLE_CALENDAR_ID=xxxxx@group.calendar.google.com
